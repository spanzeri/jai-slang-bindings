        findProfile:                        #type (this: *slang.IGlobalSession, name: *u8) -> SlangProfileID #cpp_method;

        setDownstreamCompilerPath:          #type (this: *slang.IGlobalSession, passThrough: SlangPassThrough, path: *u8) -> void #cpp_method;

        setDownstreamCompilerPrelude:       #type (this: *slang.IGlobalSession, passThrough: SlangPassThrough, preludeText: *u8) -> void #cpp_method;

        getDownstreamCompilerPrelude:       #type (this: *slang.IGlobalSession, passThrough: SlangPassThrough, outPrelude: **ISlangBlob) -> void #cpp_method;

        getBuildTagString:                  #type (this: *slang.IGlobalSession) -> *u8 #cpp_method;

        setDefaultDownstreamCompiler:       #type (this: *slang.IGlobalSession, sourceLanguage: SlangSourceLanguage, defaultCompiler: SlangPassThrough) -> SlangResult #cpp_method;

        getDefaultDownstreamCompiler:       #type (this: *slang.IGlobalSession, sourceLanguage: SlangSourceLanguage) -> SlangPassThrough #cpp_method;

        setLanguagePrelude:                 #type (this: *slang.IGlobalSession, sourceLanguage: SlangSourceLanguage, preludeText: *u8) -> void #cpp_method;

        getLanguagePrelude:                 #type (this: *slang.IGlobalSession, sourceLanguage: SlangSourceLanguage, outPrelude: **ISlangBlob) -> void #cpp_method;

        createCompileRequest:               #type (this: *slang.IGlobalSession, outCompileRequest: **slang.ICompileRequest) -> SlangResult #cpp_method;

        addBuiltins:                        #type (this: *slang.IGlobalSession, sourcePath: *u8, sourceString: *u8) -> void #cpp_method;

