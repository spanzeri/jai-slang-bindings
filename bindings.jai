        getCooperativeMatrixCombinationCount:   #type (this: *slang.ICooperativeTypesMetadata) -> SlangUInt #cpp_method;
        getCooperativeMatrixCombinationByIndex: #type (this: *slang.ICooperativeTypesMetadata, index: SlangUInt, outCombination: *slang.CooperativeMatrixCombination) -> SlangResult #cpp_method;

        getCooperativeVectorTypeCount:          #type (this: *slang.ICooperativeTypesMetadata) -> SlangUInt #cpp_method;

        getCooperativeVectorTypeByIndex:        #type (this: *slang.ICooperativeTypesMetadata, index: SlangUInt, outType: *slang.CooperativeVectorTypeUsageInfo) -> SlangResult #cpp_method;

        getCooperativeVectorCombinationCount:   #type (this: *slang.ICooperativeTypesMetadata) -> SlangUInt #cpp_method;
        getCooperativeVectorCombinationByIndex: #type (this: *slang.ICooperativeTypesMetadata, index: SlangUInt, outCombination: *slang.CooperativeVectorCombination) -> SlangResult #cpp_method;
    }
    ICooperativeTypesMetadata_getCooperativeMatrixTypeCount :: inline (this: *ICooperativeTypesMetadata) -> SlangUInt { return this.vtable.getCooperativeMatrixTypeCount(this); }

    ICooperativeTypesMetadata_getCooperativeMatrixTypeByIndex :: inline (this: *ICooperativeTypesMetadata, index: SlangUInt, outType: *CooperativeMatrixType) -> SlangResult { return this.vtable.getCooperativeMatrixTypeByIndex(this, index, outType); }

