* Returns `SLANG_UNKNOWN_SIZE` when the space depends on unresolved generic parameters or
* link-time constants.
*/
spReflectionParameter_GetBindingSpace :: (parameter: *SlangReflectionParameter) -> u32 #foreign libslang;

