    ICooperativeTypesMetadata_getCooperativeMatrixCombinationByIndex :: inline (this: *ICooperativeTypesMetadata, index: SlangUInt, outCombination: *CooperativeMatrixCombination) -> SlangResult { return this.vtable.getCooperativeMatrixCombinationByIndex(this, index, outCombination); }

