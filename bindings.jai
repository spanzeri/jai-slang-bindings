*/
spCompileRequest_getProgramWithEntryPoints :: (request: *SlangCompileRequest, outProgram: **slang.IComponentType) -> SlangResult #foreign libslang;

/** @see slang::ICompileRequest::getEntryPoint
*/
spCompileRequest_getEntryPoint :: (request: *SlangCompileRequest, entryPointIndex: SlangInt, outEntryPoint: **slang.IComponentType) -> SlangResult #foreign libslang;

/** @see slang::ICompileRequest::getModule
*/
spCompileRequest_getModule :: (request: *SlangCompileRequest, translationUnitIndex: SlangInt, outModule: **slang.IModule) -> SlangResult #foreign libslang;

/** @see slang::ICompileRequest::getSession
*/
spCompileRequest_getSession :: (request: *SlangCompileRequest, outSession: **slang.ISession) -> SlangResult #foreign libslang;

SlangLanguageVersion :: enum SlangCEnum {
    LANGUAGE_VERSION_UNKNOWN :: 0;
    LANGUAGE_VERSION_LEGACY  :: 2018;

    LANGUAGE_VERSION_202A    :: 2025;
    LANGUAGE_VERSION_2025    :: 2025;

    LANGUAGE_VERSION_202B    :: 2026;
    LANGUAGE_VERSION_2026    :: 2026;

    LANGUAGE_VERSION_202C    :: 2027;

    LANGAUGE_VERSION_DEFAULT :: 2018;
    LANGUAGE_VERSION_DEFAULT :: 2018;

    LANGUAGE_VERSION_LATEST  :: 2026;

    LANGUAGE_VERSION_NEXT    :: 2027;

    SLANG_LANGUAGE_VERSION_UNKNOWN :: LANGUAGE_VERSION_UNKNOWN;
    SLANG_LANGUAGE_VERSION_LEGACY  :: LANGUAGE_VERSION_LEGACY;

    SLANG_LANGUAGE_VERSION_202A    :: LANGUAGE_VERSION_202A;
    SLANG_LANGUAGE_VERSION_2025    :: LANGUAGE_VERSION_2025;

    SLANG_LANGUAGE_VERSION_202B    :: LANGUAGE_VERSION_202B;
    SLANG_LANGUAGE_VERSION_2026    :: LANGUAGE_VERSION_2026;

    SLANG_LANGUAGE_VERSION_202C    :: LANGUAGE_VERSION_202C;

    SLANG_LANGAUGE_VERSION_DEFAULT :: LANGAUGE_VERSION_DEFAULT;
    SLANG_LANGUAGE_VERSION_DEFAULT :: LANGUAGE_VERSION_DEFAULT;

    SLANG_LANGUAGE_VERSION_LATEST  :: LANGUAGE_VERSION_LATEST;

    SLANG_LANGUAGE_VERSION_NEXT    :: LANGUAGE_VERSION_NEXT;
}

/* Description of a Slang global session.
*/
SlangGlobalSessionDesc :: struct {
    /// Size of this struct.
    structureSize:      u32 = 80;

    /// Slang API version.
    apiVersion:         u32 = 0;

    /// Specify the oldest Slang language version that any sessions will use.
    minLanguageVersion: u32 = xx SlangLanguageVersion.LANGUAGE_VERSION_2025;

    /// Whether to enable GLSL support.
    enableGLSL          := false;

    /// Reserved for future use.
    reserved:           [16] u32;
}

/* Create a blob from binary data.
*
* @param data Pointer to the binary data to store in the blob. Must not be null.
* @param size Size of the data in bytes. Must be greater than 0.
* @return The created blob on success, or nullptr on failure.
*/
slang_createBlob :: (data: *void, size: u64) -> *ISlangBlob #foreign libslang;

/* Serialize coverage metadata into the canonical
* `.coverage-manifest.json` shape. Same bytes that `slangc` writes
* alongside compiled output when `-trace-coverage` is on, available
* in-process for hosts compiling via the C++ API.
*
* The returned JSON is consumable by
* `tools/shader-coverage/slang-coverage-to-lcov.py` and tools
* expecting the source-entry manifest format. If `metadata` is the
* artifact metadata object returned by Slang, it also supports
* `ISyntheticResourceMetadata`, and the serializer includes the
* coverage buffer's descriptor or uniform-marshaling fields when
* available.
*
* @param metadata The coverage metadata, obtained via
*                 `castAs<ICoverageTracingMetadata>` on the artifact's
*                 `IMetadata`. Must not be null.
* @param outBlob (out) The JSON bytes. Caller releases when done.
* @return `SLANG_OK` on success, `SLANG_E_INVALID_ARG` for null
*         arguments.
*/
slang_writeCoverageManifestJson :: (metadata: *slang.ICoverageTracingMetadata, outBlob: **ISlangBlob) -> SlangResult #foreign libslang;

/* Load a module from source code with size specification.
*
* @param session The session to load the module into.
* @param moduleName The name of the module.
* @param path The path for the module.
* @param source Pointer to the source code data.
* @param sourceSize Size of the source code data in bytes.
* @param outDiagnostics (out, optional) Diagnostics output.
* @return The loaded module on success, or nullptr on failure.
*/
slang_loadModuleFromSource :: (session: *slang.ISession, moduleName: *u8, path: *u8, source: *u8, sourceSize: u64, outDiagnostics: **ISlangBlob = null) -> *slang.IModule #foreign libslang;

/** Load a module from IR data.
* @param session The session to load the module into.
* @param moduleName Name of the module to load.
* @param path Path for the module (used for diagnostics).
* @param source IR data containing the module.
* @param sourceSize Size of the IR data in bytes.
* @param outDiagnostics (out, optional) Diagnostics output.
* @return The loaded module on success, or nullptr on failure.
*/
slang_loadModuleFromIRBlob :: (session: *slang.ISession, moduleName: *u8, path: *u8, source: *void, sourceSize: u64, outDiagnostics: **ISlangBlob = null) -> *slang.IModule #foreign libslang;

/** Read module info (name and version) from IR data.
* @param session The session to use for loading module info.
* @param source IR data containing the module.
* @param sourceSize Size of the IR data in bytes.
* @param outModuleVersion (out) Module version number.
* @param outModuleCompilerVersion (out) Compiler version that created the module.
* @param outModuleName (out) Name of the module.
* @return SLANG_OK on success, or an error code on failure.
*/
slang_loadModuleInfoFromIRBlob :: (session: *slang.ISession, source: *void, sourceSize: u64, outModuleVersion: *SlangInt, outModuleCompilerVersion: **u8, outModuleName: **u8) -> SlangResult #foreign libslang;

/* Create a global session, with the built-in core module.

@param apiVersion Pass in SLANG_API_VERSION
@param outGlobalSession (out)The created global session.
*/
slang_createGlobalSession :: (apiVersion: SlangInt, outGlobalSession: **slang.IGlobalSession) -> SlangResult #foreign libslang;

/* Create a global session, with the built-in core module.

@param desc Description of the global session.
@param outGlobalSession (out)The created global session.
*/
slang_createGlobalSession2 :: (desc: *SlangGlobalSessionDesc, outGlobalSession: **slang.IGlobalSession) -> SlangResult #foreign libslang;

/* Create a global session, but do not set up the core module. The core module can
then be loaded via loadCoreModule or compileCoreModule

@param apiVersion Pass in SLANG_API_VERSION
@param outGlobalSession (out)The created global session that doesn't have a core module setup.

NOTE! API is experimental and not ready for production code
*/
slang_createGlobalSessionWithoutCoreModule :: (apiVersion: SlangInt, outGlobalSession: **slang.IGlobalSession) -> SlangResult #foreign libslang;

/* Cleanup all global allocations used by Slang, to prevent memory leak detectors from
reporting them as leaks. This function should only be called after all Slang objects
have been released. No other Slang functions such as `createGlobalSession`
should be called after this function.
*/
slang_shutdown :: () -> void #foreign libslang;

/* Enable or disable the record layer for API call recording.
When enabled, API calls are captured for later replay.
The record layer can also be enabled by setting the SLANG_RECORD_LAYER=1 environment variable.

Environment variables:
- SLANG_RECORD_LAYER=1: Enable recording on startup
- SLANG_RECORD_PATH=<path>: Use the exact path specified for recording output
instead of generating a timestamped folder under .slang-replays/
*/
slang_enableRecordLayer :: (enable: bool) -> void #foreign libslang;

/* Check if the record layer is currently enabled.
*/
slang_isRecordLayerEnabled :: () -> bool #foreign libslang;

/* Set the base directory for replay files (default: ".slang-replays").
Must be called before enabling recording.
@param path Path to the replay directory.
*/
slang_setReplayDirectory :: (path: *u8) -> void #foreign libslang;

/* Get the current replay base directory.
@return Path to the replay directory.
*/
slang_getReplayDirectory :: () -> *u8 #foreign libslang;

/* Get the path to the current recording session folder.
@return Path to the current replay folder, or nullptr if not recording.
*/
slang_getCurrentReplayPath :: () -> *u8 #foreign libslang;

/* Load a replay from a folder path (reads stream.bin).
Switches to playback mode on success.
@param folderPath Path to the replay folder.
@return SLANG_OK on success, SLANG_E_NOT_FOUND if stream.bin doesn't exist.
*/
slang_loadReplay :: (folderPath: *u8) -> SlangResult #foreign libslang;

/* Load the most recent replay from the replay directory.
Switches to playback mode on success.
@return SLANG_OK on success, SLANG_E_NOT_FOUND if no replays exist.
*/
slang_loadLatestReplay :: () -> SlangResult #foreign libslang;

/* Insert a labeled marker into the replay stream.
Useful for debugging replay streams. Marks a point with a human-readable label.
No-op if the record layer is not active.
@param label The marker label string.
*/
slang_replayMarker :: (label: *u8) -> void #foreign libslang;

/* Return the last signaled internal error message.
*/
slang_getLastInternalErrorMessage :: () -> *u8 #foreign libslang;

/// Create a byte code runner that can execute Slang byte code.
slang_createByteCodeRunner :: (desc: *slang.ByteCodeRunnerDesc, outByteCodeRunner: **slang.IByteCodeRunner) -> SlangResult #foreign libslang;

/// Disassemble a Slang byte code blob into human-readable text.
slang_disassembleByteCode :: (moduleBlob: *slang.IBlob, outDisassemblyBlob: **slang.IBlob) -> SlangResult #foreign libslang;

#scope_file

#import "Basic"; // For assert


#run {
    {
        info := type_info(slang.CompilerOptionValue);
        for info.members {
            if it.name == {
                case "kind";
                    assert(it.offset_in_bytes == 0, "slang.CompilerOptionValue.kind has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 4, "slang.CompilerOptionValue.kind has unexpected size % instead of 4", it.type.runtime_size);
                case "intValue0";
                    assert(it.offset_in_bytes == 4, "slang.CompilerOptionValue.intValue0 has unexpected offset % instead of 4", it.offset_in_bytes);
                    assert(it.type.runtime_size == 4, "slang.CompilerOptionValue.intValue0 has unexpected size % instead of 4", it.type.runtime_size);
                case "intValue1";
                    assert(it.offset_in_bytes == 8, "slang.CompilerOptionValue.intValue1 has unexpected offset % instead of 8", it.offset_in_bytes);
                    assert(it.type.runtime_size == 4, "slang.CompilerOptionValue.intValue1 has unexpected size % instead of 4", it.type.runtime_size);
                case "stringValue0";
                    assert(it.offset_in_bytes == 16, "slang.CompilerOptionValue.stringValue0 has unexpected offset % instead of 16", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.CompilerOptionValue.stringValue0 has unexpected size % instead of 8", it.type.runtime_size);
                case "stringValue1";
                    assert(it.offset_in_bytes == 24, "slang.CompilerOptionValue.stringValue1 has unexpected offset % instead of 24", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.CompilerOptionValue.stringValue1 has unexpected size % instead of 8", it.type.runtime_size);
            }
        }
        assert(size_of(slang.CompilerOptionValue) == 32, "slang.CompilerOptionValue has size % instead of 32", size_of(slang.CompilerOptionValue));
    }

    {
        info := type_info(slang.CompilerOptionEntry);
        for info.members {
            if it.name == {
                case "name";
                    assert(it.offset_in_bytes == 0, "slang.CompilerOptionEntry.name has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 4, "slang.CompilerOptionEntry.name has unexpected size % instead of 4", it.type.runtime_size);
                case "value";
                    assert(it.offset_in_bytes == 8, "slang.CompilerOptionEntry.value has unexpected offset % instead of 8", it.offset_in_bytes);
                    assert(it.type.runtime_size == 32, "slang.CompilerOptionEntry.value has unexpected size % instead of 32", it.type.runtime_size);
            }
        }
        assert(size_of(slang.CompilerOptionEntry) == 40, "slang.CompilerOptionEntry has size % instead of 40", size_of(slang.CompilerOptionEntry));
    }

    {
        info := type_info(slang.ICompileRequest);
        for info.members {
            if it.name == {
                case "islangunknown";
                    assert(it.offset_in_bytes == 0, "slang.ICompileRequest.islangunknown has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.ICompileRequest.islangunknown has unexpected size % instead of 8", it.type.runtime_size);
                case "vtable";
                    assert(it.offset_in_bytes == 0, "slang.ICompileRequest.vtable has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.ICompileRequest.vtable has unexpected size % instead of 8", it.type.runtime_size);
            }
        }
        assert(size_of(slang.ICompileRequest) == 8, "slang.ICompileRequest has size % instead of 8", size_of(slang.ICompileRequest));
    }

    {
        info := type_info(slang.GenericArgReflection);
        for info.members {
            if it.name == {
                case "typeVal";
                    assert(it.offset_in_bytes == 0, "slang.GenericArgReflection.typeVal has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.GenericArgReflection.typeVal has unexpected size % instead of 8", it.type.runtime_size);
                case "intVal";
                    assert(it.offset_in_bytes == 0, "slang.GenericArgReflection.intVal has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 8, "slang.GenericArgReflection.intVal has unexpected size % instead of 8", it.type.runtime_size);
                case "boolVal";
                    assert(it.offset_in_bytes == 0, "slang.GenericArgReflection.boolVal has unexpected offset % instead of 0", it.offset_in_bytes);
                    assert(it.type.runtime_size == 1, "slang.GenericArgReflection.boolVal has unexpected size % instead of 1", it.type.runtime_size);
            }
        }
        assert(size_of(slang.GenericArgReflection) == 8, "slang.GenericArgReflection has size % instead of 8", size_of(slang.GenericArgReflection));
    }

    assert(size_of(slang.Attribute) == 1, "slang.Attribute has size % instead of 1", size_of(slang.Attribute));

    assert(size_of(slang.TypeReflection) == 1, "slang.TypeReflection has size % instead of 1", size_of(slang.TypeReflection));

    assert(size_of(slang.TypeLayoutReflection) == 1, "slang.TypeLayoutReflection has size % instead of 1", size_of(slang.TypeLayoutReflection));

    assert(size_of(slang.Modifier) == 1, "slang.Modifier has size % instead of 1", size_of(slang.Modifier));

    assert(size_of(slang.VariableReflection) == 1, "slang.VariableReflection has size % instead of 1", size_of(slang.VariableReflection));

    assert(size_of(slang.VariableLayoutReflection) == 1, "slang.VariableLayoutReflection has size % instead of 1", size_of(slang.VariableLayoutReflection));

    assert(size_of(slang.FunctionReflection) == 1, "slang.FunctionReflection has size % instead of 1", size_of(slang.FunctionReflection));

    assert(size_of(slang.GenericReflection) == 1, "slang.GenericReflection has size % instead of 1", size_of(slang.GenericReflection));

    assert(size_of(slang.EntryPointReflection) == 1, "slang.EntryPointReflection has size % instead of 1", size_of(slang.EntryPointReflection));

    assert(size_of(slang.TypeParameterReflection) == 1, "slang.TypeParameterReflection has size % instead of 1", size_of(slang.TypeParameterReflection));

    assert(size_of(slang.ShaderReflection) == 1, "slang.ShaderReflection has size % instead of 1", size_of(slang.ShaderReflection));

    {
        info := type_info(slang.DeclReflection.IteratedList.Iterator);
        for info.members {
            if it.name == {
                case "parent";
                    assert(it.offset_in_bytes == 0, "slang.DeclReflection.IteratedList.Iterator.parent has unexpected offset % instead of 0", it.offset_in_bytes);
