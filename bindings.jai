        writeToFile:               #type (this: *slang.IModule, fileName: *u8) -> SlangResult #cpp_method;

        getName:                   #type (this: *slang.IModule) -> *u8 #cpp_method;

        getFilePath:               #type (this: *slang.IModule) -> *u8 #cpp_method;

        getUniqueIdentity:         #type (this: *slang.IModule) -> *u8 #cpp_method;

        findAndCheckEntryPoint:    #type (this: *slang.IModule, name: *u8, stage: SlangStage, outEntryPoint: **slang.IEntryPoint, outDiagnostics: **ISlangBlob) -> SlangResult #cpp_method;

        getDependencyFileCount:    #type (this: *slang.IModule) -> SlangInt32 #cpp_method;

        getDependencyFilePath:     #type (this: *slang.IModule, index: SlangInt32) -> *u8 #cpp_method;

        getModuleReflection:       #type (this: *slang.IModule) -> *slang.DeclReflection #cpp_method;

        disassemble:               #type (this: *slang.IModule, outDisassembledBlob: **slang.IBlob) -> SlangResult #cpp_method;
    }
